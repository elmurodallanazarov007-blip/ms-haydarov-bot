# BotFather'dan olingan token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Majburiy obuna kanallari (username shaklida, @ bilan)
CHANNEL_1=@Matematika_milliysertifikatim
CHANNEL_2=@talimtalaba

# Kanal havolalari (tugmalarga chiqadi)
CHANNEL_1_LINK=https://t.me/Matematika_milliysertifikatim
CHANNEL_2_LINK=https://t.me/talimtalaba

# Premium custom emoji ID'lar (tugma ichida ko'rinadi, Bot API 9.4)
EMOJI_BLUE_ID=5424998072323185646
EMOJI_GREEN_ID=5451880684945708278
EMOJI_RED_ID=5273805757396031980

# Nechta referal kerak
REQUIRED_REFERRALS=5

# Maxsus yopiq guruhning chat ID'si (username emas!). Buni olish uchun:
# 1) Botni guruhga admin qilib qo'shing ("Invite users via link" huquqi bilan)
# 2) @userinfobot yoki @RawDataBot ni guruhga qo'shib chat ID'ni ko'ring
#    (odatda -100 bilan boshlanadi, masalan -1001234567890)
GROUP_CHAT_ID=-1001234567890

# Render'ga deploy qilgandan keyin shu yerga to'liq URL yoziladi
# masalan: https://ms-haydarov-bot.onrender.com
WEBHOOK_URL=

# Render avtomatik beradi, o'zgartirish shart emas
PORT=3000
